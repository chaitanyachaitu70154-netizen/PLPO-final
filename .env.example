# ==============================================================================
# Personalized Learning Path Optimizer (PLPO) - Environment Configuration
# ==============================================================================
# Phase 3: Server-side Gemini API, Adversarial Protection, and Deployment Prep
# NEVER commit real API keys to version control or expose them in UI/client code.
# The server reads GEMINI_API_KEY from environment variables automatically.
# ==============================================================================

# Server-Side AI Provider Configuration (Phase 3)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Alternative Providers (Modular Architecture)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Security & Rate Limiting Configuration
AI_RATE_LIMIT_PER_MINUTE=15
APP_ENV=production
DEBUG=False
LOG_LEVEL=INFO
STREAMLIT_SERVER_PORT=8501
